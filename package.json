{
  "name": "n8n-nodes-mtls-openai",
  "version": "0.1.0",
  "description": "n8n community nodes for OpenAI-compatible Chat Model and Embeddings with mTLS (mutual TLS) x509 client certificate authentication — for enterprise users connecting to AI inference endpoints behind auth proxies",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "mtls",
    "mutual-tls",
    "openai",
    "embeddings",
    "chat-model",
    "ssl",
    "x509",
    "client-certificate",
    "enterprise",
    "auth-proxy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JakeBx/n8n-nodes-mtls-openai",
  "repository": {
    "type": "git",
    "url": "https://github.com/JakeBx/n8n-nodes-mtls-openai.git"
  },
  "author": {
    "name": "Jacob L",
    "email": "jakeameliatravel@gmail.com"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MtlsOpenAiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MtlsOpenAiChatModel/MtlsOpenAiChatModel.node.js",
      "dist/nodes/MtlsOpenAiEmbeddings/MtlsOpenAiEmbeddings.node.js"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@n8n/node-cli": "latest",
    "@types/node": "^20.0.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "@langchain/openai": "^0.3.0",
    "typescript": "^5.3.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*",
    "@langchain/openai": "*"
  }
}
